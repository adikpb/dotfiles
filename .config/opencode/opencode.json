{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "qwen3.5-4b-mlx": {
                    "name": "qwen3.5-4b-mlx"
                }
            }
        }
    },
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "cc-safety-net@latest",
        "opencode-caffeinate@latest",
        "opencode-handoff@latest",
        "./plugins/oh-my-opencode-slim/src/index.ts"
    ],
    "permission": {
        "bash": {
            "*": "ask",
            "echo": "allow",
            "git add *": "allow",
            "git commit *": "allow",
            "git diff *": "allow",
            "git log *": "allow",
            "git show *": "allow",
            "git status *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "ls *": "allow",
            "mkdir *": "allow",
            "openspec *": "allow",
            "pytest *": "allow",
            "python -m pytest *": "allow",
            "uv run pytest *": "allow",
            "ruff *": "allow",
            "tail *": "allow",
            "wc *": "allow"
        }
    },
    "agent": {
        "explore": {
            "disable": true
        },
        "general": {
            "disable": true
        }
    },
    "lsp": {
        "pyright": {
            "disabled": true
        },
        "ty": {
            "extensions": [".py", ".pyi"],
            "command": ["uvx", "ty", "server"]
        }
    }
}
