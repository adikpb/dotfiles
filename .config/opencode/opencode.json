{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "orchestrator",
    "plugin": [
        "@tarquinen/opencode-dcp@latest",
        "cc-safety-net@latest",
        "opencode-caffeinate@latest",
        "opencode-handoff@latest",
        "./plugins/oh-my-opencode-slim/src/index.ts"
    ],
    "permission": {
        "bash": {
            "*": "ask",
            ".venv/bin/python *": "allow",
            "awk *": "allow",
            "bun *": "allow",
            "bun run *": "allow",
            "bun run check:ci": "allow",
            "bun run check *": "allow",
            "bun test *": "allow",
            "bunx biome *": "allow",
            "cat *": "allow",
            "cp *": "allow",
            "date *": "allow",
            "echo *": "allow",
            "echo": "allow",
            "find *": "allow",
            "gh *": "allow",
            "git *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "ls *": "allow",
            "mkdir *": "allow",
            "mv *": "allow",
            "pwd": "allow",
            "pytest *": "allow",
            "python -m pytest *": "allow",
            "rg *": "allow",
            "ruff *": "allow",
            "sed *": "allow",
            "stat *": "allow",
            "tail *": "allow",
            "tail -f *": "allow",
            "touch *": "allow",
            "uv run pytest *": "allow",
            "wc *": "allow"
        },
        "lsp": "allow"
    },
    "agent": {
        "build": {
            "disable": true
        },
        "explore": {
            "disable": true
        },
        "general": {
            "disable": true
        },
        "plan": {
            "disable": true
        }
    },
    "lsp": {
        "pyright": {
            "disabled": true
        },
        "ty": {
            "extensions": [".py", ".pyi"],
            "command": ["uvx", "ty", "server"]
        },
        "ruff": {
            "extensions": [".py", ".pyi"],
            "command": ["uvx", "ruff", "server"]
        }
    }
}
