{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "./plugins/oh-my-opencode-slim"
  ],
  "attention": {
    "notifications": true,
    "sound": true
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": true,
    "view": "split"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "image_preview": true,
    "new_location": "inherit",
    "permissions": "prompt",
    "tps": true,
    "verbosity": "high"
  },
  "animations": true,
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "debug": {
    "devtools": false
  }
}
